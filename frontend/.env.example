# Copy to `.env` in this folder (Expo loads it on start).
# Restart `expo start` after any change.

EXPO_PUBLIC_API_URL=https://correspondences-app-production.up.railway.app/api

# Local backend — use while backend is running (`cd backend && npm run dev`):
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Physical device on same Wi‑Fi (replace with your machine's IP):
# EXPO_PUBLIC_API_URL=http://192.168.0.74:3000/api
